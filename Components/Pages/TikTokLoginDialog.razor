@* @using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@inject TikTokAuthService AuthService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Autenticação com o TikTok</MudText>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column align-center justify-center pa-4 gap-4" style="min-height: 280px;">
            <MudText Typo="Typo.body1" Align="Align.Center">
                1. Clique no botão abaixo para abrir a página de login do TikTok no seu navegador padrão.
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Medium"
                       StartIcon="@Icons.Custom.Brands.TikTok"
                       OnClick="AbrirNavegadorExterno">
                Abrir Página de Login do TikTok
            </MudButton>

            <MudDivider Class="w-100 my-2" />

            <MudText Typo="Typo.body2" Align="Align.Center">
                2. Após autorizar, copie o código (<code style="background: rgba(0,0,0,0.1); padding: 2px 4px; border-radius: 4px;">code=...</code>) da barra de endereços do navegador e cole-o abaixo:
            </MudText>

            <div class="d-flex w-100 gap-2 align-center">
                <MudTextField @bind-Value="_codigoInput"
                              Label="Cole o código ou URL de callback aqui"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="flex-grow-1" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           OnClick="ProcessarInputManual"
                           Disabled="string.IsNullOrWhiteSpace(_codigoInput)">
                    Confirmar
                </MudButton>
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="FecharModal">Cancelar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private string _codigoInput = string.Empty;

    private void AbrirNavegadorExterno()
    {
        var urlAutorizacao = AuthService.GerarUrlAutorizacao();

        System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
        {
            FileName = urlAutorizacao,
            UseShellExecute = true
        });
    }

    private async Task ProcessarInputManual()
    {
        string codigoParaProcessar = _codigoInput.Trim();

        // Se o utilizador colou o URL completo em vez de apenas o código, extraímos o parâmetro 'code'
        if (codigoParaProcessar.Contains("code="))
        {
            try
            {
                var uri = new Uri(codigoParaProcessar);
                var queryParams = System.Web.HttpUtility.ParseQueryString(uri.Query);
                var extractedCode = queryParams["code"];
                if (!string.IsNullOrEmpty(extractedCode))
                {
                    codigoParaProcessar = extractedCode;
                }
            }
            catch
            {
                // Se falhar o parsing, tenta usar a string tal como está
            }
        }

        await ProcessarCodigoRetorno(codigoParaProcessar);
    }

    private void FecharModal()
    {
        MudDialog.Cancel();
    }

    public async Task ProcessarCodigoRetorno(string code)
    {
        bool sucesso = await AuthService.ProcessarCallbackAsync(code);
        if (sucesso)
        {
            Snackbar.Add("Autenticação do TikTok efetuada com sucesso!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add("Falha ao obter o Access Token do TikTok. Verifique o código.", Severity.Error);
        }
    }
} *@